{
  "name": "@ainative/svelte-sdk",
  "version": "1.0.0",
  "description": "Official Svelte SDK for AINative Studio API - Stores and actions for chat completions and credit management",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "svelte": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "build:watch": "rollup -c -w",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint . --ext .ts,.svelte",
    "lint:fix": "eslint . --ext .ts,.svelte --fix",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build"
  },
  "keywords": [
    "ainative",
    "svelte",
    "sveltekit",
    "stores",
    "reactive",
    "api",
    "sdk",
    "chat",
    "ai",
    "typescript"
  ],
  "author": "AINative Studio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AINative-Studio/ainative-sdks"
  },
  "bugs": {
    "url": "https://github.com/AINative-Studio/ainative-sdks/issues"
  },
  "homepage": "https://ainative.studio",
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-typescript": "^11.1.5",
    "@rollup/plugin-terser": "^0.4.4",
    "@testing-library/svelte": "^4.0.5",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^8.54.0",
    "eslint-plugin-svelte": "^2.35.0",
    "jsdom": "^23.0.1",
    "rollup": "^3.29.4",
    "rollup-plugin-dts": "^5.3.1",
    "svelte": "^4.2.8",
    "tslib": "^2.6.2",
    "typescript": "^5.3.2",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
